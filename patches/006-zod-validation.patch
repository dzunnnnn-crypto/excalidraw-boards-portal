new file mode 100644
index 0000000..87ed584
--- /dev/null
+++ b/src/core/validation.ts
@@ -0,0 +1,7 @@
+import { z } from 'zod';
+
+// Bound before walking children, including invalid items (GHSA-mrhx-c7xc-m3w5).
+// This limits schema collections, not the total number of elements on a board.
+export const MAX_VALIDATION_ITEMS = 10000;
+export const boundedArray = <T extends z.ZodType>(item: T) =>
+  z.array(item).max(MAX_VALIDATION_ITEMS);
