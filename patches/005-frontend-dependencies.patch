diff --git a/frontend/src/utils/mermaidSafety.ts b/frontend/src/utils/mermaidSafety.ts
new file mode 100644
index 0000000..146ca32
--- /dev/null
+++ b/frontend/src/utils/mermaidSafety.ts
@@ -0,0 +1,44 @@
+// MCP configuration is untrusted at runtime, even when the API has TS types.
+// Keep the supported presentation options; never accept security/CSS callbacks.
+export function safeMermaidInput(definition: string, config: unknown = {}) {
+  if (typeof definition !== 'string' || definition.length > 50000) {
+    throw new Error('Mermaid input must be text of at most 50000 characters');
+  }
+  const object = (value: unknown): Record<string, unknown> => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid Mermaid configuration');
+    return value as Record<string, unknown>;
+  };
+  const allow = (value: Record<string, unknown>, keys: string[]) => {
+    if (Object.keys(value).some(key => !keys.includes(key))) throw new Error('Unsupported Mermaid configuration option');
+  };
+  const c = object(config);
+  allow(c, ['startOnLoad', 'flowchart', 'themeVariables', 'maxEdges', 'maxTextSize']);
+  const limit = (value: unknown, max: number) => {
+    if (value === undefined) return max;
+    if (!Number.isInteger(value) || Number(value) < 1 || Number(value) > max) throw new Error('Invalid Mermaid resource limit');
+    return Number(value);
+  };
+  let curve: 'linear' | 'basis' = 'linear';
+  if (c.flowchart !== undefined) {
+    const f = object(c.flowchart); allow(f, ['curve']);
+    if (f.curve !== undefined && f.curve !== 'linear' && f.curve !== 'basis') throw new Error('Invalid Mermaid curve');
+    curve = f.curve === 'basis' ? 'basis' : 'linear';
+  }
+  let fontSize = '20px';
+  if (c.themeVariables !== undefined) {
+    const t = object(c.themeVariables); allow(t, ['fontSize']);
+    if (t.fontSize !== undefined) {
+      if (typeof t.fontSize !== 'string' || !/^(?:[89]|[1-6][0-9]|7[0-2])px$/.test(t.fontSize)) throw new Error('Invalid Mermaid font size');
+      fontSize = t.fontSize;
+    }
+  }
+  const maxTextSize = limit(c.maxTextSize, 50000);
+  if (definition.length > maxTextSize) throw new Error('Mermaid input exceeds configured text limit');
+  return {
+    startOnLoad: false,
+    securityLevel: 'strict' as const,
+    secure: ['securityLevel', 'startOnLoad', 'maxTextSize', 'maxEdges', 'suppressErrorRendering', 'secure', 'themeCSS', 'fontFamily', 'altFontFamily', 'themeVariables'],
+    flowchart: {curve}, themeVariables: {fontSize},
+    maxEdges: limit(c.maxEdges, 500), maxTextSize,
+  };
+}
