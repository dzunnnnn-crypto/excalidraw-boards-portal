diff --git a/src/core/isolated-lease.ts b/src/core/isolated-lease.ts
new file mode 100755
index 0000000..d1c7e0e
--- /dev/null
+++ b/src/core/isolated-lease.ts
@@ -0,0 +1,19 @@
+import {lstatSync,readFileSync} from 'node:fs';
+
+// The launcher must exec Node under flock --no-fork. Verify the kernel lease
+// in this PID namespace before trusting any stale durable owner metadata.
+export function heldIsolatedLease(): string | undefined {
+  const file=process.env.EXCALIDRAW_ISOLATED_LEASE;
+  if(file===undefined)return undefined;
+  if(process.platform!=='linux'||file!=='/lease/editor.lock')throw new Error('Unsupported isolated lease');
+  const stat=lstatSync(file,{bigint:true});
+  if(!stat.isFile()||stat.nlink!==1n)throw new Error('Invalid isolated lease inode');
+  const major=((stat.dev>>8n)&0xfffn)|((stat.dev>>32n)&0xfffff000n);
+  const minor=(stat.dev&0xffn)|((stat.dev>>12n)&0xffffff00n);
+  const held=readFileSync('/proc/locks','utf8').split('\n').some(line=>{
+    const match=/^\d+:\s+FLOCK\s+ADVISORY\s+WRITE\s+(\d+)\s+([a-f0-9]+):([a-f0-9]+):(\d+)\s+0\s+EOF$/i.exec(line);
+    return match&&Number(match[1])===process.pid&&BigInt('0x'+match[2])===major&&BigInt('0x'+match[3])===minor&&BigInt(match[4]!)===stat.ino;
+  });
+  if(!held)throw new Error('Editor must hold its exclusive kernel lease');
+  return `${stat.dev}:${stat.ino}`;
+}
diff --git a/src/core/unix-listener.ts b/src/core/unix-listener.ts
new file mode 100755
index 0000000..bcd3b65
--- /dev/null
+++ b/src/core/unix-listener.ts
@@ -0,0 +1,25 @@
+import fs from 'node:fs';
+import net from 'node:net';
+import path from 'node:path';
+export function unixSocketPath(): string | undefined {
+  const value=process.env.EXCALIDRAW_SOCKET_PATH;
+  if(value===undefined)return undefined;
+  if(process.platform!=='linux'||!path.isAbsolute(value)||Buffer.byteLength(value)>100||path.normalize(value)!==value)throw new Error('Invalid Unix listener path');
+  return value;
+}
+export async function prepareUnixSocket(file: string): Promise<void> {
+  let before: fs.Stats;
+  try{before=fs.lstatSync(file);}catch(e){if((e as NodeJS.ErrnoException).code==='ENOENT')return;throw e;}
+  if(!before.isSocket()||before.isSymbolicLink())throw new Error('Refusing to replace a non-socket listener path');
+  await new Promise<void>((resolve,reject)=>{
+    const socket=net.createConnection({path:file});
+    socket.setTimeout(1000);
+    socket.once('connect',()=>{socket.destroy();reject(new Error('Unix listener is already active'));});
+    socket.once('timeout',()=>{socket.destroy();reject(new Error('Unix listener state is ambiguous'));});
+    socket.once('error',(error: NodeJS.ErrnoException)=>{if(['ECONNREFUSED','ENOENT'].includes(error.code||''))resolve();else reject(error);});
+  });
+  let current: fs.Stats;
+  try{current=fs.lstatSync(file);}catch(e){if((e as NodeJS.ErrnoException).code==='ENOENT')return;throw e;}
+  if(current.dev!==before.dev||current.ino!==before.ino||!current.isSocket())throw new Error('Unix listener changed during recovery');
+  fs.unlinkSync(file);
+}
